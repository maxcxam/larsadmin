{
    "name": "{{ name }}",
    "description": "A larsadmin extension.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "maxcxam/larsadmin": "^{{ apiVersion }}"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "{{ namespaceJson }}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "{{ namespaceJson }}\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "{{ namespaceJson }}\\{{ provider }}"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
