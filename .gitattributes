# Line endings: normalise every text file to LF in the repository and in checkouts
# (overrides a contributor's core.autocrlf). The index already holds LF for all files,
# so this changes no committed content; it only stops CRLF from appearing in working
# trees on Windows. Binary files are detected automatically by "text=auto".
* text=auto eol=lf

# Built frontend assets: generated by `npm run build`, collapsed in diffs on GitHub.
/dist/** linguist-generated=true -diff

# Excluded from the Composer dist archive (`composer require` with --prefer-dist).
# They stay in the git repository; a --prefer-source install or a clone still has them.
#
# Development and CI only.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/tests export-ignore
/phpunit.xml export-ignore
#
# Frontend build kit. The service provider publishes the prebuilt /dist (tag
# larsadmin-assets) and loads only resources/views, so the Vue/CSS sources and the
# tooling that compiles them are not needed at runtime. Rebuilding the UI means
# changing the package itself, which is done from a clone of the repository.
/resources/js export-ignore
/resources/css export-ignore
/scripts export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/vite.config.js export-ignore
/vite.kit.config.js export-ignore
/vitest.config.js export-ignore
*.test.js export-ignore
#
# /kit (extension author kit: Vite preset, kit/sdk.js, test helpers, theme.css, the public API checker
# kit/check-public-api.mjs with its snapshot kit/public-api.json) is deliberately NOT excluded:
# extensions use it from vendor/maxcxam/larsadmin/kit after `composer require` (design 1.5 §6.4, Q-66).
# kit/sdk.js is generated by `npm run build`; collapsed in diffs like dist/.
/kit/sdk.js linguist-generated=true -diff
