{
    "name": "maxcxam/larsadmin",
    "description": "An admin panel for Laravel, built with Inertia and Vue 3.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "admin", "admin-panel", "inertia", "vue"],
    "homepage": "https://github.com/maxcxam/larsadmin",
    "authors": [
        {
            "name": "Maksym Rudenko",
            "email": "maxcxam1979@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/maxcxam/larsadmin/issues",
        "source": "https://github.com/maxcxam/larsadmin"
    },
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^12.0|^13.0",
        "symfony/finder": "^7.2|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "laravel/scout": "^11.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "suggest": {
        "laravel/scout": "Searches models using Laravel\\Scout\\Searchable through their search engine in the global search (^11.0)."
    },
    "autoload": {
        "psr-4": {
            "Maxcxam\\Larsadmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maxcxam\\Larsadmin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maxcxam\\Larsadmin\\LarsadminServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
